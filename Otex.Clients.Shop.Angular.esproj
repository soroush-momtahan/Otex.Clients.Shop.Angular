<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5581896">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <PublishAssetsDirectory>$(MSBuildProjectDirectory)\dist\Otex.Clients.Shop.Angular\browser\</PublishAssetsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="src\app\core\directives\" />
    <Folder Include="src\app\features\banners\components\" />
    <Folder Include="src\app\features\cooperation\components\" />
    <Folder Include="src\app\features\products\components\" />
    <Folder Include="src\app\pages\" />
    <Folder Include="src\app\pages\cooperation\components\" />
    <Folder Include="src\app\pages\home\components\" />
    <Folder Include="src\app\pages\products\components\" />
  </ItemGroup>
</Project>
